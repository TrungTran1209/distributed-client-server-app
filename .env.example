# Cấu hình biến môi trường mẫu (Ứng dụng đọc trực tiếp từ biến môi trường hệ điều hành,
# KHÔNG tự động nạp tệp .env — dùng `export` trên Linux/macOS hoặc `$env:VAR = "..."` trên PowerShell).

# Server (`python -m collab.server.main`)
COLLAB_HOST=127.0.0.1
COLLAB_PORT=37021
COLLAB_UDP_PORT=37020
# COLLAB_ADVERTISE_HOST=192.168.1.20
COLLAB_TLS_CERT=certs/server.crt
COLLAB_TLS_KEY=certs/server.key
COLLAB_DATABASE=data/users.sqlite3
COLLAB_IDLE_TIMEOUT=90
COLLAB_AUTH_TIMEOUT=60

# Client (`python -m collab.client.main`)
COLLAB_SERVER_HOST=127.0.0.1
COLLAB_SERVER_PORT=37021
COLLAB_UDP_PORT=37020
COLLAB_DISCOVERY_HOST=127.0.0.1
COLLAB_TLS_CA_FILE=certs/server.crt
COLLAB_DOWNLOAD_DIR=downloads
